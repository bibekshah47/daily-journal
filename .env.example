# Copy this file to .env and fill it in. .env is ignored by git: never commit it.
# Variables already set in your shell win over this file.

# "development" (the default) or "production".
# Production refuses to start unless SECRET_KEY is set to a real secret.
APP_ENV=development

# Signs the session cookie (the "Entry saved." messages, and later, logins).
# Leave empty for local development. For production, generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Local development: the SQLite database file (default: journal.db). Daily
# backups are saved in a backups/ folder next to it. JOURNAL_DATABASE still works too.
DATABASE=journal.db

# PostgreSQL (required in production). When set, it is used instead of DATABASE.
# Paste the connection string from your host, e.g. Neon:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Keep the real value in .env or your host's settings, never in this file.
DATABASE_URL=

# Optional: a PostgreSQL database for running the tests against PostgreSQL
# (TEST_DB=postgres python -m unittest discover -s tests). Use a separate,
# throwaway database (a Neon branch works) and its direct, non-pooled URL.
TEST_DATABASE_URL=

# Outgoing email, for password reset links. In development, emails are printed
# to the terminal instead of sent. In production without MAIL_SERVER they are
# not sent (and never printed, since they hold reset links).
# Mail is sent with STARTTLS (usually port 587).
MAIL_SERVER=
MAIL_PORT=587
# Login for the mail server (often an API key from your email provider).
MAIL_USERNAME=
MAIL_PASSWORD=
# The sender address; emails come from "Innerdesk <MAIL_FROM>".
# Defaults to MAIL_USERNAME.
MAIL_FROM=

# Production: the host name(s) the app is served at, comma-separated, e.g.
# TRUSTED_HOSTS=innerdesk.onrender.com
# Requests for any other host are refused (400), so reset links can't be
# forged. /healthz is exempt, for Render's health checker.
TRUSTED_HOSTS=
